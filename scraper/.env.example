# Copy to .env and adjust. All values have sensible defaults.

# Source API (discovered from the h2hggl.com SPA bundle).
H2HGGL_API_BASE=https://api-h2h.hudstats.com/v1
H2HGGL_SITE_BASE=https://h2hggl.com
H2HGGL_URL_SPORT=ebasketball         # ebasketball | esoccer | eamericanfootball

# Politeness / caching.
H2HGGL_POLITE_DELAY_MS=800
H2HGGL_CACHE_TTL=300
H2HGGL_REQUEST_TIMEOUT=25

# Background refresh cadence (minutes; 0 disables).
H2HGGL_REFRESH_GAMES_MIN=10
H2HGGL_REFRESH_PLAYERS_MIN=30
H2HGGL_FEED_DAYS=14

# Persistence + CORS.
H2HGGL_DB_PATH=./h2hgg.db
H2HGGL_CORS_ORIGINS=*
