# Copy this to .env.local and fill in your values.
# On Vercel: add these in Project Settings → Environment Variables.

# Primary (free) source — base URL of the self-hosted h2hggl scraper (see /scraper).
# Local dev default is http://localhost:8000.
H2HGGL_API_URL=http://localhost:8000

# Optional — route the direct h2hggl API calls through the Cloudflare Worker in /worker.
# Needed when the API's Cloudflare bot protection blocks Vercel's IPs ("Just a moment...").
# H2HGGL_API_BASE=https://h2hggl-proxy.<your-account>.workers.dev/v1
# H2HGGL_PROXY_KEY=<same value as the Worker's PROXY_KEY secret>

# Optional fallback — your BetsAPI token (get from betsapi.com). Not required.
# BETSAPI_TOKEN=your_token_here

# Optional — override the league/sport IDs if you ever use a different feed
# GG_LEAGUE_ID=25067
# GG_SPORT_ID=18

# Optional — enables the AI Analyst view (server-side only; never sent to the browser)
# ANTHROPIC_API_KEY=sk-ant-...
